# Copy this file to .env. Empty values use the defaults in compose.yaml and docker/compose.langfuse.yaml.
# Do not put real secrets in this example file.

# Hugging Face token for faster model downloads (optional)
HF_TOKEN=

# llama-cpp main model (CPU and GPU tuning)
LLM_THREADS=
LLM_THREADS_BATCH=
LLM_CTX_SIZE=
LLM_KV_CACHE_TYPE=
LLM_BATCH=
LLM_UBATCH=
LLM_MOE_CACHE_MIB=
LLM_LOAD_MODE=

# llama-decision and llama-embed (CPU threads)
DECISION_LLM_THREADS=
EMBED_LLM_THREADS=

# LiteLLM gateway and cloud providers (keys are optional)
LITELLM_MASTER_KEY=
DEEPINFRA_API_KEY=
REFUSELESS_API_KEY=

# Langfuse stack (langfuse-web on host port 3001)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_URL=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_PG_USER=
LANGFUSE_PG_PASSWORD=
LANGFUSE_PG_DB=
LANGFUSE_REDIS_AUTH=
LANGFUSE_CLICKHOUSE_USER=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_USER=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# YuE2 music services (profile music, optional)
YUE2_API_KEY= # gitleaks:allow (empty example value)
YUE2_MAX_PENDING=
YUE2_UNLOAD_AFTER_JOB=
YUE2_RETENTION_SECONDS=
YUE2_MAX_GIB=
YUE2_STOP_LLAMA=
