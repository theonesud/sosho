# cp .env.example .env  (or run 'make autotune' to generate automatically)
UID=1000
GID=1000

# CPU Execution Threads
LLM_THREADS=5
LLM_THREADS_BATCH=6

# Context Window & Memory
LLM_CTX_SIZE=65536
LLM_KV_CACHE_TYPE=q4_0
LLM_UBATCH=512
LLM_BATCH=2048
LLM_MLOCK=true
LLM_CPU_MASK=0x0

# Observability (Langfuse)
LANGFUSE_BASE_URL=http://127.0.0.1:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-pi
LANGFUSE_SECRET_KEY=sk-lf-local-pi
LANGFUSE_NEXTAUTH_SECRET=local-dev-secret-change-me
LANGFUSE_SALT=local-dev-salt-change-me
LANGFUSE_ENCRYPTION_KEY=736d927cc28b9ca18fc47a3c5f4a6ee5074deb57ba4f1b004b894e0c50f24144
LANGFUSE_PG_USER=postgres
LANGFUSE_PG_PASSWORD=postgres
LANGFUSE_PG_DB=postgres
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_REDIS_AUTH=localredis
LANGFUSE_MINIO_USER=minio
LANGFUSE_MINIO_PASSWORD=miniosecret
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_PASSWORD=password123

# Studio & Gateway Auth
# SOSHO_STUDIO_TOKEN=change-me-to-a-random-hex-token
# YUE2_API_KEY=change-me-if-exposed-beyond-loopback

# Optional Hugging Face Token for accelerated downloads
# HF_TOKEN=

# Optional Cloud API keys (for hybrid routing in any workspace)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REFUSELESS_API_KEY=
# DEEPINFRA_API_KEY=
