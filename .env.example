# cp .env.example .env  (or run 'make autotune' to generate automatically)
UID=1000
GID=1000

# CPU Execution Threads
LLM_THREADS=5
LLM_THREADS_BATCH=6

# Context Window & Memory
LLM_CTX_SIZE=65536
LLM_KV_CACHE_TYPE=q4_0
LLM_UBATCH=512
LLM_BATCH=2048
LLM_MLOCK=true
LLM_CPU_MASK=0x0

# Observability
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-pi
LANGFUSE_SECRET_KEY=sk-lf-local-pi

# Optional Hugging Face Token for accelerated downloads
# HF_TOKEN=

# Optional Cloud API keys (for hybrid routing in any workspace)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
