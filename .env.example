# cp .env.example .env  (then adjust)
# Generate quickly:
#   printf "UID=%s\nGID=%s\nLLM_THREADS=%s\n" $(id -u) $(id -g) $(( $(lscpu -b -p=Core,Socket | grep -v '^#' | sort -u | wc -l) - 2 )) >> .env
UID=1000
GID=1000
# physical cores minus 2, keeps the desktop responsive
LLM_THREADS=8
# LLM Context Window (default: 65536 tokens; 131072 requires ~16GB VRAM for KV cache alone)
LLM_CTX_SIZE=65536
# LLM KV Cache quantization (q8_0, q4_0, f16)
LLM_KV_CACHE_TYPE=q8_0
# HF_TOKEN=
# LLAMA_BASE_URL=http://127.0.0.1:8080

# Langfuse Observability
# LANGFUSE_BASE_URL=http://127.0.0.1:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-pi
# LANGFUSE_SECRET_KEY=sk-lf-local-pi

# YuE2 music stack (profile: music)
# Uncomment to include the music stack in a plain `docker compose up -d`:
# COMPOSE_PROFILES=music
# YUE2_MODELS_DIR=./models/yue2-3b
# YUE2_GATEWAY_PORT=8021
# YUE2_GATEWAY_URL=http://127.0.0.1:8021
# YUE2_API_KEY=
# YUE2_UNLOAD_AFTER_JOB=true
# YUE2_MAX_PENDING=4
# YUE2_RETENTION_SECONDS=86400
# YUE2_MAX_GIB=5
# Pause llama.cpp while YuE2 generates, then start it again (needs docker.sock).
# YUE2_STOP_LLAMA=true
# YUE2_LLAMA_CONTAINER=llama-cpp
