FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git ripgrep curl python3 python3-pip \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g @earendil-works/pi-coding-agent @dokobot/cli@latest @langfuse/pi-observability-plugin@latest

ENV NODE_PATH=/usr/local/lib/node_modules/@langfuse/pi-observability-plugin/node_modules:/usr/local/lib/node_modules

WORKDIR /workspace
ENTRYPOINT ["pi"]
