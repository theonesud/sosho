{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/Qwen3.6-35B-A3B",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B-A3B",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      ".pi/models.json": "deny",
      ".pi/model-roles.json": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask"
    }
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "tsx", "packages/memory/src/mcp.ts"],
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.86", "--headless"],
      "environment": {}
    }
  }
}
