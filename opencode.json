{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/Qwen3.6-35B-A3B",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B-A3B",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".pi/models.json": "deny",
      ".pi/model-roles.json": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask"
    }
  }
}
