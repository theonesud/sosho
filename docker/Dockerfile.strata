FROM rust:1.100.0-slim-bookworm AS build
ARG STRATA_REPO=https://github.com/theonesud/RustingStrata.git
ARG STRATA_SHA=c33b153a08bbc53ababf578eecb33ed6a0fec33e
# hadolint ignore=DL3020
ADD ${STRATA_REPO}?ref=${STRATA_SHA} /src
WORKDIR /src
# target-cpu=native builds the image for the CPU of the build host (i5-12400F, AVX2). Do not run it on another CPU.
ENV RUSTFLAGS="-C target-cpu=native"
RUN cargo build --release --locked && cp target/release/rustingstrata /rustingstrata

FROM ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates=20260816ubuntu0.24.04.2 curl=8.5.0-2ubuntu10.16 \
 && curl -fsSL -o /tmp/keyring.deb https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
 && dpkg -i /tmp/keyring.deb \
 && rm /tmp/keyring.deb \
 && apt-get update \
 && apt-get install -y --no-install-recommends cuda-nvrtc-13-5=13.5.37-1 \
 && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/usr/local/cuda-13.5/targets/x86_64-linux/lib \
    STRATA_NVRTC=libnvrtc.so.13 \
    STRATA_NO_UPDATE_CHECK=1 \
    XDG_CACHE_HOME=/cache \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
COPY --from=build /rustingstrata /usr/local/bin/rustingstrata
ENTRYPOINT ["rustingstrata"]
