{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(./.env)",
      "Edit(./.pi/models.json)",
      "Edit(./.pi/model-roles.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/bin/agent-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/bin/agent-post-edit.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/bin/agent-format.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "cleanupPeriodDays": 3650,
  "theme": "dark",
  "spinnerTipsEnabled": false,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "idleCompaction": false,
  "enabledMcpjsonServers": ["memory", "playwright"],
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR}/bin/statusline.sh\""
  }
}
