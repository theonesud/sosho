{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Edit(./.pi/models.json)",
      "Edit(./.pi/model-roles.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/bin/agent-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/bin/agent-post-edit.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
