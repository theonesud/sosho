{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["tsx", "/opt/sosho/packages/memory/src/mcp.ts"]
    },
    "langgraph": {
      "url": "http://langgraph:8123/mcp",
      "transport": "streamable-http"
    },
    "langflow": {
      "url": "http://langflow:7860/api/v1/mcp/sse",
      "transport": "sse"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    }
  }
}
