{
  "defaultProvider": "litellm",
  "defaultModel": "main",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32768
  },
  "packages": [
    "npm:pi-lens"
  ],
  "defaultTools": [
    "read",
    "write",
    "edit",
    "bash",
    "task_plan",
    "task_update",
    "task_status",
    "task_finish",
    "subagent_run",
    "subagent_parallel",
    "memory_search",
    "memory_save",
    "memory_forget",
    "memory_consolidate",
    "+codemode",
    "+tool_search"
  ],
  "extensions": [
    "./extensions/guard/src/index.ts",
    "-builtin:llama.cpp",
    "./extensions/phoenix/src/index.ts",
    "./extensions/scratchpad/src/index.ts",
    "./extensions/subagents/src/index.ts",
    "./extensions/memory/src/index.ts"
  ],
  "lastChangelogVersion": "1.6.1",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-lens\",\"scope\":\"project\"}": "4.5.2"
  }
}