{
  "name": "sosho-langfuse-extension",
  "version": "0.1.2",
  "description": "Langfuse observability extension for Pi with system prompt capture",
  "license": "MIT",
  "author": "Langfuse",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfuse/pi-observability-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/langfuse/pi-observability-plugin/issues"
  },
  "homepage": "https://github.com/langfuse/pi-observability-plugin#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "langfuse",
    "observability",
    "tracing",
    "opentelemetry"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:unit": "node --test test/unit.test.ts test/config.test.ts"
  },
  "dependencies": {
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/sdk-trace-node": "2.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "26.6.6",
    "npm": "12.2.3",
    "typescript": "7.0.2"
  }
}
